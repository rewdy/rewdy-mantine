{
  "name": "@rewdy/mantine",
  "version": "1.0.0",
  "description": "A Mantine 9 theme of full-bleed tint bands, teal-tinted neutrals and flat, square surfaces.",
  "keywords": [
    "design-system",
    "mantine",
    "mantine-theme",
    "react",
    "theme"
  ],
  "license": "MIT",
  "author": "Andrew Meyer",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./fonts.css": "./dist/fonts.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/karla": "^5.3.0"
  },
  "devDependencies": {
    "@mantine/core": "9.5.0",
    "@mantine/hooks": "9.5.0",
    "@types/node": "^26.6.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "6.0.3",
    "vite": "^8.3.1",
    "vite-plugin-dts": "^5.1.1",
    "vitest": "^5.0.2"
  },
  "peerDependencies": {
    "@mantine/core": ">=9.0.0",
    "@mantine/hooks": ">=9.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.24.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@11.24.0"
}
